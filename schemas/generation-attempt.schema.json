{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ruhang365/ruhang365-shotflow/main/schemas/generation-attempt.schema.json",
  "title": "ShotFlow Generation Attempt Ledger v1",
  "type": "object",
  "required": ["ledger_version", "case_id", "attempts"],
  "properties": {
    "ledger_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "attempt_id",
          "variant",
          "status",
          "recorded_at",
          "provider",
          "prompt",
          "references",
          "output",
          "reason"
        ],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "variant": {
            "type": "string",
            "enum": ["clip-01", "clip-02-baseline", "clip-02-shotflow"]
          },
          "status": {
            "type": "string",
            "enum": ["submitted", "accepted", "rejected", "failed"]
          },
          "recorded_at": {"type": "string", "format": "date-time"},
          "provider": {"type": "object"},
          "prompt": {"$ref": "#/$defs/artifact"},
          "references": {
            "type": "object",
            "required": ["source_video", "source_final_frame"],
            "properties": {
              "source_video": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
              "source_final_frame": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
            },
            "additionalProperties": false
          },
          "output": {
            "type": "object",
            "required": ["video", "final_frame"],
            "properties": {
              "video": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
              "final_frame": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
            },
            "additionalProperties": false
          },
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
